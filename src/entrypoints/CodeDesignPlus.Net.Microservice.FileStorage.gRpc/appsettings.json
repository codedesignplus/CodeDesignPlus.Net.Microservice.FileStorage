{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000",
        "Protocols": "Http1"
      },
      "Http2": {
        "Url": "http://*:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Core": {
    "Id": "f10b2c58-0e03-45d7-b2f3-06960cb5690f",
    "AppName": "ms-filestorage",
    "TypeEntryPoint": "grpc",
    "Version": "v1",
    "Description": "This microservice manages the connection to cloud storage resources, handling per-tenant indexing.",
    "Business": "CodeDesignPlus",
    "Contact": {
      "Name": "CodeDesignPlus",
      "Email": "support@codedesignplus.com"
    }
  },
  "Security": {
    "IncludeErrorDetails": true,
    "ValidateAudience": true,
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "RequireHttpsMetadata": true,
    "ValidIssuer": "",
    "ValidAudiences": [],
    "Applications": [],
    "ValidateLicense": false,
    "ValidateRbac": false,
    "ServerRbac": "http://localhost:5001",
    "RefreshRbacInterval": 10
  },
  "Redis": {
    "Instances": {
      "Core": {
        "ConnectionString": "localhost:6379"
      }
    }
  },
  "RedisCache": {
    "Enable": true,
    "Expiration": "00:05:00"
  },
  "RabbitMQ": {
    "Enable": false,
    "UseQueue": false,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "user",
    "Password": "pass",
    "EnableDiagnostic": true
  },
  "ServiceBus": {
    "Enable": true,
    "UseQueue": false,
    "EnableDiagnostic": true
  },
  "Mongo": {
    "Enable": true,
    "Database": "db-ms-filestorage",
    "Diagnostic": {
      "Enable": false,
      "EnableCommandText": false
    }
  },
  "Logger": {
    "Enable": true,
    "OTelEndpoint": "http://localhost:4317",
    "Level": "Warning"
  },
  "Observability": {
    "Enable": true,
    "ServerOtel": "http://localhost:4317",
    "Trace": {
      "Enable": true,
      "AspNetCore": true,
      "GrpcClient": true,
      "SqlClient": false,
      "CodeDesignPlusSdk": true,
      "Redis": true,
      "Kafka": false,
      "RabbitMQ": true
    },
    "Metrics": {
      "Enable": true,
      "AspNetCore": true
    }
  },
  "Vault": {
    "Enable": true,
    "Address": "http://localhost:8200",
    "AppName": "ms-filestorage",
    "Solution": "security-codedesignplus",
    "Token": "root",
    "Mongo": {
      "Enable": true,
      "TemplateConnectionString": "mongodb://{0}:{1}@localhost:27017"
    },
    "RabbitMQ": {
      "Enable": true
    }
  },
  "FileStorage": {
    "UriDownload": "http://localhost:5000/api/v1/filestorage/download",
    "Local": {
      "Enable": false,
      "Folder": "path/to/local/storage"
    },
    "AzureFile": {
      "Enable": false,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    },
    "AzureBlob": {
      "Enable": true,
      "DefaultEndpointsProtocol": "https",
      "AccountName": "",
      "AccountKey": "",
      "EndpointSuffix": "core.windows.net"
    }
  },
  "GrpcClients": {
    "Notification": "http://ms-notification-grpc.codedesignplus.svc.cluster.local:5001"
  }
}
